# Copy this file to .env and change every value before using docker compose.
# .env is listed in .gitignore, so real secrets are never committed.

DB_USER=edumate
DB_PASSWORD=change-me-database-password

# At least 32 characters. Signs the login tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# Shared with the payment gateway to sign payment callbacks.
PAYMENT_GATEWAY_SECRET=change-me-gateway-secret

# Demo switches: set both to false for anything other than a demonstration.
DEMO_SEED=true
DEMO_EXPOSE_OTP=true
