# Store every text file with LF line endings inside git, whatever the OS.
* text=auto eol=lf

# Windows batch / PowerShell scripts must keep CRLF or cmd.exe misreads them.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch their bytes.
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.jar binary
